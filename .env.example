# ── PayPal configuration ─────────────────────────────
# Copy these into Vercel → Project → Settings → Environment Variables.
# (Locally you can put real values in a .env file — never commit it.)

# "sandbox" for testing, "live" for real money
PAYPAL_ENV=sandbox

# From the PayPal Developer Dashboard → Apps & Credentials → your app
PAYPAL_CLIENT_ID=your-client-id-here
PAYPAL_CLIENT_SECRET=your-client-secret-here

# Optional — defaults to USD if unset
PAYPAL_CURRENCY=USD
